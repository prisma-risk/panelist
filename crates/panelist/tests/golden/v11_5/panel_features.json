{
  "id": null,
  "uid": "panel-features",
  "title": "Panel features",
  "tags": [],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "avg(up{job=\"$job\"})",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Up"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "from": 0.0,
                "result": {
                  "color": "yellow",
                  "index": 1,
                  "text": "Degraded"
                },
                "to": 0.99
              },
              "type": "range"
            },
            {
              "options": {
                "match": "null",
                "result": {
                  "index": 2,
                  "text": "No data"
                }
              },
              "type": "special"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://runbook.example/api",
          "targetBlank": true
        }
      ],
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests, last week",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum(rate(http_requests_total{job=\"$job\"}[$__rate_interval]))",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "interval": "1m",
      "maxDataPoints": 500,
      "timeShift": "7d"
    },
    {
      "id": 4,
      "type": "row",
      "title": "Per instance",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "repeat": "job",
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests on $instance",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum(rate(http_requests_total{instance=\"$instance\"}[$__rate_interval]))",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "links": [
            {
              "title": "Instance logs",
              "url": "/explore?instance=${__field.labels.instance}&$__url_time_range"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "repeat": "instance",
      "repeatDirection": "h",
      "maxPerRow": 3
    },
    {
      "id": 6,
      "type": "table",
      "title": "Status on $instance",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "up{instance=\"$instance\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "pattern": "^(.*):\\d+$",
                "result": {
                  "index": 0,
                  "text": "$1"
                }
              },
              "type": "regex"
            },
            {
              "options": {
                "match": "empty",
                "result": {
                  "index": 1,
                  "text": "-"
                }
              },
              "type": "special"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Targets",
                    "url": "/targets?instance=${__data.fields.instance}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "repeat": "instance",
      "repeatDirection": "v"
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "allValue": null,
        "allowCustomValue": false,
        "current": {
          "selected": true,
          "text": "api",
